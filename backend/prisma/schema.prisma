generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  PARENT
}

enum Level {
  A1
  A2
  B1
  B2
  C1
  C2
  GENERAL
}

enum MaterialType {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  FORM
}

enum PaymentState {
  PENDING
  PAID
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  role         Role         @default(STUDENT)
  courseDurationMonths Int?
  monthlyFee   Int?
  courseStartDate DateTime?
  createdAt    DateTime     @default(now())

  // Relación familiar Padre ↔ Hijos
  parentId     String?
  parent       User?        @relation("FamilyRelation", fields: [parentId], references: [id], onDelete: SetNull)
  children     User[]       @relation("FamilyRelation")

  profile      Profile?
  courses      Course[]     @relation("TeacherCourses")
  enrollments  Enrollment[]
  submissions  Submission[]
  materials    Material[]
  materialAssignments MaterialAssignment[] @relation("StudentMaterialAssignments")
  paymentStatuses PaymentStatus[] @relation("StudentPayments")
  markedPayments  PaymentStatus[] @relation("MarkedPayments")
  assignments     Assignment[]    @relation("StudentAssignments")
  createdAssignments Assignment[] @relation("TeacherAssignments")
  sentChatMessages ChatMessage[] @relation("SentChatMessages")
  receivedChatMessages ChatMessage[] @relation("ReceivedChatMessages")
  finalEvaluation FinalEvaluation? @relation("StudentFinalEvaluation")
}

model ChatMessage {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  studentId   String?
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sender      User     @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedChatMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([studentId, createdAt])
}

model Profile {
  id        String    @id @default(uuid())
  userId    String    @unique
  firstName String
  lastName  String
  avatarUrl String?
  dni       String?   // DNI / NIE
  phone     String?   // Teléfono de contacto / WhatsApp
  birthDate DateTime? // Fecha de nacimiento
  address   String?   // Dirección completa
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SkillCategory {
  GRAMMAR_VOCABULARY
  READING
  SPEAKING
  WRITING
  LISTENING
  MOCK_EXAM
}

model Course {
  id          String       @id @default(uuid())
  title       String
  teacherId   String
  teacher     User         @relation("TeacherCourses", fields: [teacherId], references: [id])
  enrollments Enrollment[]
  assignments Assignment[]
  posts       Post[]
}

model Post {
  id        String   @id @default(uuid())
  courseId  String
  content   String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id])
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  enrolledAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
}

model Assignment {
  id          String         @id @default(uuid())
  teacherId   String
  courseId    String?
  studentId   String?
  materialId  String?
  title       String
  description String?
  dueDate     DateTime?
  category    SkillCategory  @default(GRAMMAR_VOCABULARY)
  
  teacher     User           @relation("TeacherAssignments", fields: [teacherId], references: [id])
  course      Course?        @relation(fields: [courseId], references: [id])
  student     User?          @relation("StudentAssignments", fields: [studentId], references: [id])
  material    Material?      @relation(fields: [materialId], references: [id])
  submissions Submission[]
}

model Submission {
  id           String     @id @default(uuid())
  assignmentId String
  studentId    String
  content      String?

  grade        Float?
  feedback     String?
  submittedAt  DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  student      User       @relation(fields: [studentId], references: [id])
}

model Material {
  id          String        @id @default(uuid())
  title       String
  description String?
  type        MaterialType
  level       Level         @default(GENERAL)
  category    SkillCategory @default(GRAMMAR_VOCABULARY)
  url         String?
  formData    Json?
  teacherId   String
  teacher     User          @relation(fields: [teacherId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  materialAssignments MaterialAssignment[]
  assignments Assignment[]
}

enum MaterialAssignmentStatus {
  PENDING
  COMPLETED
}

model MaterialAssignment {
  id         String                   @id @default(uuid())
  materialId String
  studentId  String
  deadline   DateTime?
  status     MaterialAssignmentStatus @default(PENDING)
  assignedAt DateTime                 @default(now())
  material   Material                 @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student    User                     @relation("StudentMaterialAssignments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([materialId, studentId])
  @@index([studentId, assignedAt])
}

model PaymentStatus {
  id         String   @id @default(uuid())
  studentId  String
  markedById String?
  month      Int
  year       Int
  amount     Int      @default(0)
  dueDate    DateTime @default(now())
  paidAt     DateTime?
  status     PaymentState @default(PENDING)
  isPaid     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  student    User     @relation("StudentPayments", fields: [studentId], references: [id])
  markedBy   User?    @relation("MarkedPayments", fields: [markedById], references: [id])

  @@unique([studentId, month, year])
  @@index([studentId, dueDate])
}

model FinalEvaluation {
  id           String   @id @default(uuid())
  studentId    String   @unique
  grammar      Float?
  reading      Float?
  writing      Float?
  listening    Float?
  speaking     Float?
  overallGrade Float?
  observations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      User     @relation("StudentFinalEvaluation", fields: [studentId], references: [id], onDelete: Cascade)
}
