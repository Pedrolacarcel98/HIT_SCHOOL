generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  PARENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Modality {
  PRESENCIAL
  ONLINE
  HIBRIDO
}

enum Level {
  A1
  A2
  B1
  B2
  C1
  C2
  GENERAL
}

enum MaterialType {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  FORM
}

enum PaymentState {
  PENDING
  PAID
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(STUDENT)
  status       UserStatus @default(INACTIVE)
  modality     Modality   @default(PRESENCIAL)
  createdAt    DateTime   @default(now())

  // Relación familiar Padre ↔ Hijos
  parentId String?
  parent   User?   @relation("FamilyRelation", fields: [parentId], references: [id], onDelete: SetNull)
  children User[]  @relation("FamilyRelation")

  profile                    Profile?
  courses                    Course[]                     @relation("TeacherCourses")
  academyEnrollments         AcademyEnrollment[]
  enrollments                Enrollment[]
  submissions                Submission[]
  materials                  Material[]
  materialAssignments        MaterialAssignment[]         @relation("StudentMaterialAssignments")
  paymentStatuses            PaymentStatus[]              @relation("StudentPayments")
  markedPayments             PaymentStatus[]              @relation("MarkedPayments")
  assignments                Assignment[]                 @relation("StudentAssignments")
  createdAssignments         Assignment[]                 @relation("TeacherAssignments")
  sentChatMessages           ChatMessage[]                @relation("SentChatMessages")
  receivedChatMessages       ChatMessage[]                @relation("ReceivedChatMessages")
  finalEvaluation            FinalEvaluation?             @relation("StudentFinalEvaluation")
  structuredTasks            StructuredTask[]             @relation("AssignedStructuredTasks")
  createdStructuredTasks     StructuredTask[]             @relation("TeacherStructuredTasks")
  structuredTaskAssignments  StructuredTaskStudent[]
  structuredTaskStepProgress StructuredTaskStepProgress[]
  taskDeliveries             TaskDelivery[]
  termGrades                 TermGrade[]
}

model ChatMessage {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  studentId   String?
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sender      User     @relation("SentChatMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("ReceivedChatMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([studentId, createdAt])
}

model Profile {
  id                      String    @id @default(uuid())
  userId                  String    @unique
  firstName               String
  lastName                String
  avatarUrl               String?
  dni                     String? // DNI / NIE
  phone                   String? // Teléfono de contacto / WhatsApp
  birthDate               DateTime? // Fecha de nacimiento
  address                 String? // Dirección completa
  schoolYear              String? // Curso escolar
  allergies               String? // Alergias o necesidades médicas
  imageAuthorization      Boolean? // Autorización para uso de imagen
  imageAuthorizationScope String? // Alcance de autorización de imagen
  observations            String? // Observaciones del alumno
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SkillCategory {
  GRAMMAR_VOCABULARY
  READING
  SPEAKING
  WRITING
  LISTENING
  MOCK_EXAM
}

model Course {
  id              String           @id @default(uuid())
  title           String
  modality        Modality         @default(PRESENCIAL)
  teacherId       String
  teacher         User             @relation("TeacherCourses", fields: [teacherId], references: [id])
  enrollments     Enrollment[]
  assignments     Assignment[]
  posts           Post[]
  structuredTasks StructuredTask[]
  termGrades      TermGrade[]
}

model Post {
  id        String   @id @default(uuid())
  courseId  String
  content   String   @default("")
  mediaUrl  String?
  mediaType String?
  mediaName String?
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model AcademyEnrollment {
  id            String          @id @default(uuid())
  studentId     String
  startDate     DateTime
  endDate       DateTime?
  monthlyFee    Int
  billingPeriod BillingPeriod   @default(MONTHLY)
  student       User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments      PaymentStatus[]

  @@index([studentId])
}

model Assignment {
  id                   String        @id @default(uuid())
  teacherId            String
  courseId             String?
  studentId            String?
  materialId           String?
  structuredTaskStepId String?       @unique
  title                String
  description          String?
  dueDate              DateTime?
  publishAt            DateTime?
  category             SkillCategory @default(GRAMMAR_VOCABULARY)

  teacher            User                @relation("TeacherAssignments", fields: [teacherId], references: [id])
  course             Course?             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student            User?               @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  material           Material?           @relation(fields: [materialId], references: [id])
  structuredTaskStep StructuredTaskStep? @relation(fields: [structuredTaskStepId], references: [id], onDelete: SetNull)
  submissions        Submission[]
}

model Submission {
  id               String  @id @default(uuid())
  assignmentId     String
  studentId        String
  content          String?
  structuredTaskId String?
  formId           String?

  grade       Float?
  feedback    String?
  submittedAt DateTime   @default(now())
  assignment  Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student     User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Material {
  id                  String               @id @default(uuid())
  title               String
  description         String?
  type                MaterialType
  level               Level                @default(GENERAL)
  category            SkillCategory        @default(GRAMMAR_VOCABULARY)
  url                 String?
  formData            Json?
  teacherId           String
  teacher             User                 @relation(fields: [teacherId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  materialAssignments MaterialAssignment[]
  assignments         Assignment[]
  structuredTaskSteps StructuredTaskStep[]
}

enum StructuredTaskAssignmentType {
  CLASS
  INDIVIDUAL
}

model StructuredTask {
  id                String                       @id @default(uuid())
  title             String
  description       String?
  dueDate           DateTime?
  publishAt         DateTime?
  term              Int                          @default(1)
  isTemplate        Boolean                      @default(false)
  category          SkillCategory                @default(GRAMMAR_VOCABULARY)
  courseId          String?
  teacherId         String?
  assignmentType    StructuredTaskAssignmentType @default(CLASS)
  isSequential      Boolean                      @default(false)
  assignedStudentId String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  course            Course?                      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher           User?                        @relation("TeacherStructuredTasks", fields: [teacherId], references: [id], onDelete: Cascade)
  assignedStudent   User?                        @relation("AssignedStructuredTasks", fields: [assignedStudentId], references: [id], onDelete: SetNull)
  assignedStudents  StructuredTaskStudent[]
  steps             StructuredTaskStep[]
  deliveries        TaskDelivery[]

  @@index([courseId])
  @@index([teacherId])
  @@index([assignedStudentId])
  @@index([isTemplate])
}

model StructuredTaskStudent {
  id        String         @id @default(uuid())
  taskId    String
  studentId String
  task      StructuredTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student   User           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
  @@index([studentId])
}

model StructuredTaskStep {
  id                 String                       @id @default(uuid())
  taskId             String
  order              Int
  title              String
  materialId         String?
  requiresSubmission Boolean                      @default(false)
  task               StructuredTask               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  material           Material?                    @relation(fields: [materialId], references: [id], onDelete: SetNull)
  progress           StructuredTaskStepProgress[]
  assignment         Assignment?

  @@index([taskId, order])
}

model StructuredTaskStepProgress {
  id          String             @id @default(uuid())
  stepId      String
  studentId   String
  completedAt DateTime           @default(now())
  step        StructuredTaskStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  student     User               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([stepId, studentId])
  @@index([studentId])
}

enum MaterialAssignmentStatus {
  PENDING
  COMPLETED
}

model MaterialAssignment {
  id         String                   @id @default(uuid())
  materialId String
  studentId  String
  deadline   DateTime?
  publishAt  DateTime?
  status     MaterialAssignmentStatus @default(PENDING)
  assignedAt DateTime                 @default(now())
  material   Material                 @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student    User                     @relation("StudentMaterialAssignments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([materialId, studentId])
  @@index([studentId, assignedAt])
}

model PaymentStatus {
  id           String             @id @default(uuid())
  studentId    String
  enrollmentId String?
  markedById   String?
  month        Int
  year         Int
  amount       Int                @default(0)
  dueDate      DateTime           @default(now())
  paidAt       DateTime?
  status       PaymentState       @default(PENDING)
  isPaid       Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  student      User               @relation("StudentPayments", fields: [studentId], references: [id], onDelete: Cascade)
  enrollment   AcademyEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  markedBy     User?              @relation("MarkedPayments", fields: [markedById], references: [id])

  @@unique([studentId, month, year])
  @@index([studentId, dueDate])
}

model FinalEvaluation {
  id           String   @id @default(uuid())
  studentId    String   @unique
  grammar      Float?
  reading      Float?
  writing      Float?
  listening    Float?
  speaking     Float?
  overallGrade Float?
  observations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      User     @relation("StudentFinalEvaluation", fields: [studentId], references: [id], onDelete: Cascade)
}

model TaskDelivery {
  id          String    @id @default(uuid())
  taskId      String
  studentId   String
  grade       Float? // Nota final / media de la tarea
  feedback    String? // Feedback global del docente para la tarea completa
  status      String    @default("COMPLETED") // IN_PROGRESS, COMPLETED, GRADED
  deliveredAt DateTime  @default(now())
  gradedAt    DateTime?

  task    StructuredTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student User           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
  @@index([studentId])
  @@index([taskId])
}

model TermGrade {
  id           String @id @default(uuid())
  studentId    String
  courseId     String
  term         Int // 1, 2, 3
  academicYear String @default("2025-2026")

  // Notas formales para alumnos presenciales (evaluaciones de Laura / profesores)
  middleExamGrade Float?
  finalExamGrade  Float?

  // Medias calculadas
  tasksAverage Float? // Media calculada continua de las tareas del trimestre
  overallGrade Float? // Nota trimestral definitiva (Presencial: 50% exámenes + 50% tareas | Online: 100% tareas)

  // Desglose por competencias CEFR (para el boletín)
  grammar   Float?
  reading   Float?
  writing   Float?
  listening Float?
  speaking  Float?

  observations String? // Feedback pedagógico general del docente para el trimestre
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId, term, academicYear])
  @@index([courseId, term])
  @@index([studentId])
}
